PORT=3000
FRONTEND_URL=https://anchor-gym-system.vercel.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Gmail SMTP: use a Google App Password, not your regular Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-verification-sender@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM="ANCHOR GYM <your-verification-sender@gmail.com>"

# Google Cloud OAuth 2.0 Web application client ID.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
