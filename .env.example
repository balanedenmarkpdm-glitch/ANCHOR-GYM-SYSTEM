PORT=3000
# Optional override for signing rotating member QR codes; defaults to DATABASE_URL.
QR_TOKEN_SECRET=
GUEST_TIMER_TEST_MODE=false
GYM_OPENING_TIME=08:00
GYM_CLOSING_TIME=22:00
FRONTEND_URL=https://anchor-gym-system.vercel.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Google Cloud OAuth 2.0 Web application client ID.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Gmail SMTP app-password settings used to send password reset codes.
# Create an app password for the sending Gmail account and configure both
# values on the backend. EMAIL_FROM defaults to GMAIL_USER.
GMAIL_USER=balanedenmark.pdm@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_FROM=

# Optional explicit secret for hashing reset codes. If omitted, the backend
# derives it from GOOGLE_CLIENT_SECRET or GMAIL_APP_PASSWORD.
RESET_CODE_SECRET=

# Alternatively, configure Gmail API OAuth instead of SMTP:
GMAIL_REFRESH_TOKEN=

# Optional: select a PostgreSQL schema; defaults to public.
DATABASE_SCHEMA=public

# Admin login requires an existing users account with role admin or staff.
# Optionally configure these once to create an initial admin on first login.
# Use a unique password of at least 12 characters; do not use a shared default.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional: dedicated DB for automated integration tests. If omitted, tests
# create and drop a uniquely named temporary schema in DATABASE_URL.
TEST_DATABASE_URL=
