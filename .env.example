PORT=3000
# Optional override for signing rotating member QR codes; defaults to DATABASE_URL.
QR_TOKEN_SECRET=
GUEST_TIMER_TEST_MODE=false
GYM_CLOSING_TIME=22:00
FRONTEND_URL=https://anchor-gym-system.vercel.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Google Cloud OAuth 2.0 Web application client ID.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Gmail API settings used to deliver password reset codes. Enable Gmail API
# and authorize GOOGLE_CLIENT_ID for the gmail.send OAuth scope.
GMAIL_REFRESH_TOKEN=
EMAIL_FROM=balanedenmark.pdm@gmail.com

# Optional: select a PostgreSQL schema; defaults to public.
DATABASE_SCHEMA=public

# Admin login requires an existing users account with role admin or staff;
# the application does not create or promote a customer account automatically.

# Optional: dedicated DB for automated integration tests. If omitted, tests
# create and drop a uniquely named temporary schema in DATABASE_URL.
TEST_DATABASE_URL=
